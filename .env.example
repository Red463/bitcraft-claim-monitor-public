# BitCraft Settlement Monitor
# Production values belong in /etc/bitcraft-claim-monitor-public.env.

NODE_ENV=production
APP_HOST=127.0.0.1
APP_PORT=18430
BITCRAFT_LOCAL_DATA_DIR=/var/lib/bitcraft-claim-monitor-public
PUBLIC_URL=https://claim-monitor.com
CANONICAL_ORIGIN=https://claim-monitor.com

BITJITA_API_ORIGIN=https://bitjita.com
BITJITA_APP_IDENTIFIER="BitCraft Settlement Monitor (github.com/Red463/bitcraft-claim-monitor-public)"
# BITJITA_FETCH_TIMEOUT_MS=15000
# BITJITA_PROXY_TIMEOUT_MS=12000
# BITJITA_PROXY_CACHE_MS=15000
# BITJITA_PROXY_STALE_IF_ERROR_MS=300000
# MAX_ACTIVE_CLAIMS=25

# Dedicated administrator-only Discord OAuth application.
DEFAULT_OWNER_DISCORD_ID=145544610234630144
ADMIN_DISCORD_OAUTH_CLIENT_ID=replace-with-admin-oauth-application-id
ADMIN_DISCORD_OAUTH_CLIENT_SECRET=replace-with-admin-oauth-client-secret
ADMIN_DISCORD_OAUTH_REDIRECT_URI=https://claim-monitor.com/api/local/admin/auth/discord/callback

ENABLE_SERVER_POLLING=true
ENABLE_SCHEDULED_JOBS=true
SNAPSHOT_INTERVAL_MS=30000

# Optional visitor-security location enrichment.
# GEOIP_DATA_PATH=/var/lib/bitcraft-claim-monitor-public/geoip/geoip.json
# IPAPI_BASE_URL=https://ipapi.co
