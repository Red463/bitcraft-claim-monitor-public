[Unit]
Description=BitCraft Settlement Monitor public worker
After=network-online.target bitcraft-claim-monitor-public.service
Wants=network-online.target

[Service]
Type=simple
User=claimmonitor
Group=claimmonitor
WorkingDirectory=/opt/bitcraft-claim-monitor-public/current/apps/bitcraft-local
Environment=NODE_ENV=production
Environment=BITCRAFT_LOCAL_DATA_DIR=/var/lib/bitcraft-claim-monitor-public
Environment=BITCRAFT_PROCESS_ROLE=worker
Environment=MALLOC_TRIM_THRESHOLD_=131072
EnvironmentFile=/etc/bitcraft-claim-monitor-public.env
ExecStart=/usr/bin/node /opt/bitcraft-claim-monitor-public/current/apps/bitcraft-local/worker.mjs
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/bitcraft-claim-monitor-public /var/backups/bitcraft-claim-monitor-public

[Install]
WantedBy=multi-user.target
