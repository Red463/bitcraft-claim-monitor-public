[Unit]
Description=BitCraft Settlement Monitor public telemetry collector
After=network-online.target

[Service]
Type=oneshot
User=root
Group=claimmonitor
Environment=BITCRAFT_LOCAL_DATA_DIR=/var/lib/bitcraft-claim-monitor-public
ExecStart=/usr/bin/node /opt/bitcraft-claim-monitor-public/current/deploy/collect-server-health.mjs
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/bitcraft-claim-monitor-public/monitoring
