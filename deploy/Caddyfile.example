{
	email {$ACME_EMAIL}
}

claim-monitor.com {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; connect-src 'self' https://bitjita.com https://api.bitjita.com; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://discord.com"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		X-Frame-Options SAMEORIGIN
	}
	reverse_proxy 127.0.0.1:18430 {
		lb_try_duration 5s
		lb_try_interval 250ms
		lb_retry_match {
			method GET HEAD
		}
	}
	handle_errors {
		@api path /api/*
		handle @api {
			header Content-Type application/json
			respond `{"error":"BitCraft Settlement Monitor is updating. Retry in a few seconds."}` 503
		}
		respond "BitCraft Settlement Monitor is updating. Please retry in a few seconds." 503
	}
}

www.claim-monitor.com {
	redir https://claim-monitor.com{uri} permanent
}
